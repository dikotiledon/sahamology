# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# netlify
.netlify/
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
# .env.example is the operator-facing template (documents every profile and its
# default) and is read by the Phase 4 default-off gate. It holds no secrets, so
# it is committed; the local .env stays ignored.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# extension
stockbit-token-extension/manifest.json
stockbit-token-extension/background.js
!stockbit-token-extension/*.example

# runtime artifacts
artifacts/adi-baseline.json
artifacts/g4-walkforward.json
artifacts/phase2-walkforward.json
artifacts/phase3-walkforward.json

# local plan/ledger scratch (not product code)
.hermes/
.unlazy/
.superpowers/

# local watch-forward build artifact
scripts/.g4-watch.cjs
