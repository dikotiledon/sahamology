{
  "manifest_version": 3,
  "name": "Stockbit Token Syncer",
  "version": "1.0",
  "description": "Captures Bearer token from Stockbit and syncs it to the self-hosted Sahamology API.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.stockbit.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
