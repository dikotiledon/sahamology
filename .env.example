# =============================================================================
# Sahamology self-hosted environment template
# Copy to .env (Docker Compose) or export in the PM2 shell environment.
# =============================================================================

# --- Database (PostgreSQL 16) -------------------------------------------------
# Docker Compose derives this from POSTGRES_* when the app container talks to
# the `db` service. For a remote PostgreSQL, set DATABASE_URL directly.
POSTGRES_DB=sahamology
POSTGRES_USER=sahamology
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://sahamology:change-me-strong-password@localhost:5432/sahamology

# --- Redis (BullMQ) -----------------------------------------------------------
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# --- Application network ------------------------------------------------------
APP_PORT=3000
# Publicly reachable URL (browser/extension-facing). Examples:
#   http://localhost:3000
#   http://192.168.1.4:3000
#   https://stocks.example.com
#   http://203.0.113.10:3000
APP_BASE_URL=http://localhost:3000
# Internal loopback used by in-process schedulers/workers.
INTERNAL_API_URL=http://127.0.0.1:3000

# --- Security -----------------------------------------------------------------
# Shared secret for cron/worker triggers (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=change-me
# Secret for HMAC session-token signing. REQUIRED in production; must not be
# any of the well-known defaults. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Force cookie Secure flag: true | false | (unset = auto via X-Forwarded-Proto/NODE_ENV)
# COOKIE_SECURE=

# --- Stockbit -----------------------------------------------------------------
# Optional manual fallback token; normally synced by the Chrome extension.
STOCKBIT_JWT_TOKEN=
# Fallback IDX emitens for the daily watchlist analysis job (comma-separated).
# Used ONLY when the Stockbit watchlist contains no usable IDX emiten, e.g. when
# it holds just a forex pair like USDIDR. Leave empty to analyze the Stockbit
# watchlist only. Each emiten yields roughly one signal per trading day, so
# ~5-8 liquid blue chips is enough to accumulate a statistically useful sample.
# WATCHLIST_FALLBACK_EMITENS=BBCA,BBRI,TLKM,BMRI,ASII,BBNI,BBTN,INDF

# --- AI story generation ------------------------------------------------------
# LLM_PROVIDER: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_STORY_MODEL=gemini-3-flash-preview
# MINIMAL | LOW | MEDIUM | HIGH
GEMINI_STORY_THINKING_LEVEL=HIGH
# OpenAI-compatible settings (used when LLM_PROVIDER=openai)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Millisecond timeout for one story generation (default 240000 = 4 min)
GEMINI_STORY_TIMEOUT_MS=240000

# --- Playbook gate profiles --------------------------------------------------
# Each gate is OFF unless its profile is explicitly set, and an unrecognised
# value degrades to 'off' rather than arming anything.
#   PLAYBOOK_G1_PROFILE=phase-1|phase-2   micro accumulation / broker flow
#   PLAYBOOK_G5_PROFILE=off|visible|veto  fundamental-health veto (Phase 3)
#   PLAYBOOK_G7_PROFILE=off|visible|veto  macro-regime hold (Phase 4)

# G7 — macro regime. Default 'off'.
#
# 'off'      the regime is classified and shown, but never changes a stance.
# 'visible'  same display, and a CAUTION is reported on the card.
# 'veto'     an armed CAUTION downgrades ENTER to WAIT. One notch, never AVOID.
#
# 'veto' currently changes NOTHING in practice, and that is deliberate rather
# than a bug. Every clause bound in G7 is still UNMEASURED: the Phase 4
# correlation study (npm run macro:correlation) armed 0 of 3 clauses on the
# available data, because 13 signals over 3 dates is far below the 30-observation
# floor a bound needs. An unarmed clause cannot fire, so the honest default is
# 'off' and the honest answer from the walk-forward is VERDICT_UNREACHABLE.
# Do not arm this until the study reports a non-zero ARMED_CLAUSES on a sample
# that meets the floor — see docs/SELF_HOSTED.md.
PLAYBOOK_G7_PROFILE=off

# The USD/IDR leg reads Stockbit's MARKET SPOT rate for US Dollar / Rupiah, not
# Bank Indonesia's official volume-weighted JISDOR benchmark. JISDOR is computed
# from interbank rupiah demand-supply at end of day and is not published as a
# ticker on this feed. The system therefore names the series USDIDR everywhere
# and treats it as a JISDOR PROXY, not as JISDOR itself: the two track each other
# over time but are not the same series, and no claim in this repo depends on
# them being equal. Renaming the leg to JISDOR would be a false claim.
